    "See the trends behind your sleep — bedtime consistency, energy, and duration over time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh die Trends hinter deinem Schlaf — Schlafenszeit-Konstanz, Energie und Dauer im Zeitverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre las tendencias detrás de tu sueño — constancia de la hora de dormir, energía y duración a lo largo del tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre les tendances de ton sommeil — régularité du coucher, énergie et durée dans le temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri le tendenze del tuo sonno — costanza dell'orario, energia e durata nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の傾向を可視化 — 就寝時間の一貫性、エネルギー、睡眠時間の推移。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 뒤에 숨은 추이를 확인하세요 — 취침 시간 일관성, 에너지, 수면 시간."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie de trends achter je slaap — bedtijdconsistentie, energie en duur in de tijd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as tendências por trás do seu sono — consistência da hora de dormir, energia e duração ao longo do tempo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se trenderna bakom din sömn — läggdagskonsekvens, energi och längd över tid."
          }
        }
      }
    },
