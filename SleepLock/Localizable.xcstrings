    "3-day free trial, then auto-renews until canceled. Cancel anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Tage gratis, danach automatische Verlängerung bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間無料、その後は解約するまで自動更新。設定でいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 무료 후 해지할 때까지 자동 갱신. 설정에서 언제든 해지할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dagen gratis, daarna automatische verlenging tot opzegging. Altijd opzegbaar in Instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dagar gratis, sedan automatisk förnyelse tills du avslutar. Avsluta när som helst i Inställningar."
          }
        }
      }
    },
