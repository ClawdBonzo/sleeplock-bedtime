        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je slaapplan\nis klaar!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sömnplan\när redo!"
          }
        }
      }
    },
    "Your Wind-Down Routine": {
