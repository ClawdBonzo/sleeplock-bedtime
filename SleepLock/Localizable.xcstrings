    "Your full streak history, month by month, with hit-rate stats.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein vollständiger Serienverlauf, Monat für Monat, mit Trefferquote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月ごとの全連続記録履歴と達成率の統計。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 전체 연속 기록과 달성률 통계."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je volledige reeksgeschiedenis, maand voor maand, met slagingsstatistieken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela din svithistorik, månad för månad, med träffstatistik."
          }
        }
      }
    },
