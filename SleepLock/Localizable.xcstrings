    "Lights out, %@! Keep your streak alive by getting to bed now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht aus, %@! Geh jetzt ins Bett und halte deine Serie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Luces fuera, %@! Mantén tu racha viva yendo a dormir ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extinction des feux, %@ ! Garde ta série en allant te coucher maintenant."
          }
        },
        "it": {
