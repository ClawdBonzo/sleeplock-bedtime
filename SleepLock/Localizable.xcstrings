    "Build a consistent bedtime.\nTrack your streak. Wake up powerful.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Schlafenszeit aufbauen.\nSerie verfolgen. Kraftvoll aufwachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una hora de dormir constante.\nSigue tu racha. Despierta con energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopte une heure de coucher régulière.\nSuis ta série. Réveille-toi en pleine forme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci un orario di andare a letto costante.\nTieni traccia della tua serie. Svegliati con energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日同じ時間に就寝。\n連続記録を伸ばし、力強く目覚めよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관된 취침 시간을 만드세요.\n연속 기록을 쌓고 활기차게 일어나세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw een vast bedtijd op.\nVolg je reeks. Word krachtig wakker."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha uma hora de dormir consistente.\nAcompanhe sua sequência. Acorde com energia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg en fast läggdags.\nFölj din svit. Vakna stark."
          }
        }
      }
    },
