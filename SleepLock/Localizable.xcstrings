    "It's 15 minutes past your bedtime. Every minute counts for your streak and energy score!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist 15 Minuten nach deiner Schlafenszeit. Jede Minute zählt für Serie und Energie-Score!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han pasado 15 minutos de tu hora de dormir. ¡Cada minuto cuenta para tu racha y tu puntuación de energía!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est 15 minutes après ton heure de coucher. Chaque minute compte pour ta série et ton score d'énergie !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono passati 15 minuti dalla tua ora di andare a letto. Ogni minuto conta per la serie e il punteggio energia!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時間を15分過ぎています。1分1分が連続記録とエネルギースコアに影響します！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 시간이 15분 지났어요. 1분 1분이 연속 기록과 에너지 점수에 중요해요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is 15 minuten na je bedtijd. Elke minuut telt voor je reeks en energiescore!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já se passaram 15 minutos da sua hora de dormir. Cada minuto conta para sua sequência e pontuação de energia!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är 15 minuter över din läggdags. Varje minut räknas för din svit och energipoäng!"
          }
        }
      }
    },
