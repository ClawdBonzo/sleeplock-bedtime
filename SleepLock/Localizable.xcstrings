    "Your purchase went through but Pro didn't activate. Tap Restore, and contact support if it persists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf war erfolgreich, aber Pro wurde nicht aktiviert. Tippe auf „Wiederherstellen“ und kontaktiere den Support, falls es bestehen bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se procesó, pero Pro no se activó. Toca «Restaurar» y contacta al soporte si el problema persiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat a été effectué mais Pro ne s'est pas activé. Appuie sur Restaurer, et contacte l'assistance si le problème persiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è andato a buon fine ma Pro non si è attivato. Tocca Ripristina e contatta l'assistenza se il problema persiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、Proが有効になりませんでした。「復元」をタップし、解決しない場合はサポートにご連絡ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 완료되었지만 Pro가 활성화되지 않았습니다. '복원'을 탭해 보시고, 문제가 계속되면 지원팀에 문의해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt, maar Pro is niet geactiveerd. Tik op 'Herstel' en neem contact op met support als het aanhoudt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra foi concluída, mas o Pro não foi ativado. Toque em Restaurar e entre em contato com o suporte se o problema persistir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp gick igenom men Pro aktiverades inte. Tryck på Återställ och kontakta supporten om det kvarstår."
          }
        }
      }
    },
