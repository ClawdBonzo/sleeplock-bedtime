    "How did you sleep, %@? Log your bedtime and energy level to keep your streak going!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hast du geschlafen, %@? Erfasse Schlafenszeit und Energie, um deine Serie fortzusetzen!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo dormiste, %@? Registra tu hora de dormir y nivel de energía para mantener tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment as-tu dormi, %@ ? Enregistre ton heure de coucher et ton énergie pour poursuivre ta série !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come hai dormito, %@? Registra l'orario e il livello di energia per continuare la tua serie!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、よく眠れましたか？就寝時間とエネルギーを記録して連続記録を続けましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님, 잘 주무셨나요? 취침 시간과 에너지를 기록하고 연속 기록을 이어가세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe heb je geslapen, %@? Log je bedtijd en energie om je reeks voort te zetten!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você dormiu, %@? Registre sua hora de dormir e nível de energia para manter sua sequência!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur sov du, %@? Logga läggdags och energi för att hålla din svit vid liv!"
          }
        }
      }
    },
