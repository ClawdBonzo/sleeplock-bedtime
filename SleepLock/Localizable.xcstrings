    "Hey %@, time to start your sleep routine! Your energized self will thank you tomorrow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey %@, Zeit für deine Schlafroutine! Dein energiegeladenes Ich wird es dir morgen danken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola %@, ¡es hora de comenzar tu rutina de sueño! Tu yo con energía te lo agradecerá mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hé %@, il est temps de commencer ta routine de sommeil ! Ton toi plein d'énergie te remerciera demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehi %@, è ora di iniziare la tua routine del sonno! Il tuo io pieno di energia ti ringrazierà domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、睡眠ルーティンを始める時間です！明日の元気なあなたが感謝しますよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님, 수면 루틴을 시작할 시간이에요! 내일의 활기찬 당신이 고마워할 거예요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hé %@, tijd voor je slaaproutine! Je energieke ik zal je morgen dankbaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei, %@, hora de começar sua rotina de sono! Seu eu cheio de energia vai agradecer amanhã."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej %@, dags för din sömnrutin! Ditt energifyllda jag tackar dig imorgon."
          }
        }
      }
    },
