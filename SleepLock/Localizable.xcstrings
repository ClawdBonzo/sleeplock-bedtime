    "3-day free trial, then auto-renews until canceled. Cancel anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Tage gratis, danach automatische Verlängerung bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratis de 3 días; luego se renueva automáticamente hasta que canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit de 3 jours, puis renouvellement automatique jusqu'à annulation. Annule à tout moment dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3 giorni di prova gratuita, poi rinnovo automatico fino alla disdetta. Disdici quando vuoi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間無料、その後は解約するまで自動更新。設定でいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 무료 후 해지할 때까지 자동 갱신. 설정에서 언제든 해지할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dagen gratis, daarna automatische verlenging tot opzegging. Altijd opzegbaar in Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste grátis de 3 dias, depois renovação automática até o cancelamento. Cancele quando quiser nas Configurações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dagar gratis, sedan automatisk förnyelse tills du avslutar. Avsluta när som helst i Inställningar."
          }
        }
      }
    },
