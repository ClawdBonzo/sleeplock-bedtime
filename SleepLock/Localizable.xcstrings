    "How did you sleep, %@? Log your bedtime and energy level to keep your streak going!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie hast du geschlafen, %@? Erfasse Schlafenszeit und Energie, um deine Serie fortzusetzen!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、よく眠れましたか？就寝時間とエネルギーを記録して連続記録を続けましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님, 잘 주무셨나요? 취침 시간과 에너지를 기록하고 연속 기록을 이어가세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe heb je geslapen, %@? Log je bedtijd en energie om je reeks voort te zetten!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur sov du, %@? Logga läggdags och energi för att hålla din svit vid liv!"
          }
        }
      }
    },
