    "Track your sleep streak and bedtime at a glance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Serie und Schlafenszeit auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tu racha de sueño y hora de dormir de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis ta série de sommeil et ton heure de coucher en un coup d'œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia della tua serie e dell'orario di andare a letto a colpo d'occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の連続記録と就寝時間を一目で確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 연속 기록과 취침 시간을 한눈에."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie je slaapreeks en bedtijd in één oogopslag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe sua sequência de sono e hora de dormir em um só lugar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din sömnsvit och läggdags på en gång."
          }
        }
      }
    },
